{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            },
            {
              "id": "machines",
              "type": "block",
              "size": {
                "px": 0
              },
              "content": {
                "mod": "machines",
                "props": {
                  "block": "machines",
                  "show": "several"
                }
              }
            },
            {
              "id": "tab-namer",
              "type": "block",
              "size": {
                "px": 0
              },
              "content": {
                "mod": "tab-namer"
              }
            },
            {
              "id": "mod-patches",
              "type": "block",
              "size": {
                "px": 0
              },
              "content": {
                "mod": "mod-patches"
              }
            },
            {
              "id": "cite-watch",
              "type": "block",
              "size": {
                "px": 0
              },
              "content": {
                "mod": "cite",
                "props": {
                  "role": "watch"
                }
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 41
          },
          "content": {
            "mod": "workspace-chrome-synced",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs-synced"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "cite",
                      "type": "block",
                      "content": {
                        "mod": "cite",
                        "props": {
                          "role": "panel"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status-row",
          "type": "row",
          "size": {
            "px": 28
          },
          "resizable": false,
          "children": [
            {
              "id": "status",
              "type": "block",
              "size": {
                "weight": 1
              },
              "content": {
                "mod": "workspace-status-synced"
              }
            },
            {
              "id": "machines-bar",
              "type": "block",
              "size": {
                "px": 0
              },
              "content": {
                "mod": "machines",
                "props": {
                  "compact": true,
                  "block": "machines-bar",
                  "show": "one"
                }
              }
            },
            {
              "id": "open-vscode",
              "type": "block",
              "size": {
                "px": 34
              },
              "content": {
                "mod": "open-vscode"
              }
            },
            {
              "id": "keep-awake",
              "type": "block",
              "size": {
                "px": 34
              },
              "content": {
                "mod": "keep-awake"
              }
            },
            {
              "id": "usage-limits",
              "type": "block",
              "size": {
                "px": 360
              },
              "content": {
                "mod": "usage-limits"
              }
            }
          ]
        }
      ]
    }
  ],
  "preview": "layouts/herdr-plus.svg"
}
